{
  "appId": "br.com.gushrs.organizacaocredito",
  "appName": "Chacun",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "adjustMarginsForEdgeToEdge": "force"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#0c0f0e",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "body"
    }
  }
}
