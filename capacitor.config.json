{
  "appId": "br.com.gushrs.organizacaocredito",
  "appName": "Chacun",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "adjustMarginsForEdgeToEdge": "force"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#0b0d12",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "body"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_chacun",
      "iconColor": "#5B8CFF"
    }
  }
}
